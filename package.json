{
  "name": "advent-calendar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A private, server-enforced Advent calendar gift (React + Netlify Functions + Supabase).",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:netlify": "netlify dev",
    "build": "tsc -b && vite build",
    "postbuild": "tsx scripts/check-public-output.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "content:validate": "tsx scripts/content-validate.ts",
    "content:import": "tsx scripts/content-import.ts",
    "content:backup": "tsx scripts/content-backup.ts",
    "content:init-private": "tsx scripts/content-init-private.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "passphrase:hash": "tsx scripts/passphrase-hash.ts",
    "sessions:revoke": "tsx scripts/sessions-revoke.ts",
    "verify:deployment": "tsx scripts/verify-deployment.ts",
    "screenshots": "playwright test --project=screenshots"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@netlify/functions": "^6.1.1",
    "@playwright/test": "^1.65.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "postgres": "^4.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
