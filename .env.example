# Copy to .env.local for local owner scripts (import, migrations, backups).
# .env.local is gitignored. In Netlify, set the same names in the UI with
# scope "Functions" (never "Builds"-only, never VITE_* prefixed).
# None of these values may ever start with VITE_ — that would put them in
# the public JavaScript bundle.

# Postgres connection string (privileged). For Netlify Functions use the
# Supabase *transaction pooler* string (port 6543), e.g.
#   postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional: a session-pooler or direct connection string for `npm run db:migrate`
# (port 5432). Falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=

# Supabase project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=

# Privileged server key for Storage (signed URLs, uploads). Use either the
# new secret key (sb_secret_...) or the legacy service_role key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private bucket name (created by the migration). Default: advent-private
ADVENT_MEDIA_BUCKET=advent-private

# Which calendar the site serves, e.g. advent-2026 (must match calendarId
# in your content file).
ADVENT_CALENDAR_ID=advent-2026

# scrypt hash of the access passphrase, from `npm run passphrase:hash`.
# Never store the passphrase itself anywhere.
ADVENT_PASSPHRASE_HASH=
